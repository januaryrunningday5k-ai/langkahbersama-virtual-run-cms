PORT=3000
NODE_ENV=production
BASE_URL=https://your-domain.example
DB_FILE=/data/cms.db
SESSION_SECRET=REPLACE_WITH_RANDOM_48_BYTE_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD

# Stripe test keys for staging; replace with live credentials only after release approval
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP provider credentials; sender/domain must be verified with the provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Virtual Run Events <noreply@your-domain.example>

# Optional Strava OAuth app
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
