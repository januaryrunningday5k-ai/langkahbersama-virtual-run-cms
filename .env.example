PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Stripe Checkout (leave unset to disable online checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP for automatic paid-ticket delivery (leave unset to log a setup warning)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LangkahBersama Events <noreply@example.com>

# Optional Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
