# Runtime
NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.example
DB_FILE=/var/lib/virtual-run/cms.db

# Generate a unique value, for example: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Stripe Checkout and webhook secrets (Stripe Dashboard -> Developers -> Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP credentials from your transactional email provider; required for participant verification and ticket delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Virtual Run Events <noreply@your-domain.example>

# Optional Strava OAuth application
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
